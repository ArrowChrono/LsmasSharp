+static void apply_indexed_padding(lwlibav_audio_decode_handler_t* adhp, AVPacket* packet, uint32_t frame_number)
+{
+    if (frame_number != 1 && frame_number != adhp->frame_count && adhp->ctx->codec_id != AV_CODEC_ID_OPUS)
+        return;
+    size_t size = 0;
+    uint8_t* side = av_packet_get_side_data(packet, AV_PKT_DATA_SKIP_SAMPLES, &size);
+    if (!side || size < 10)
+        side = av_packet_new_side_data(packet, AV_PKT_DATA_SKIP_SAMPLES, 10);
+    if (!side)
+        return;
+    memset(side, 0, 10);
+    AV_WL32(side, frame_number == 1 ? adhp->initial_padding : 0);
+    AV_WL32(side + 4, frame_number == adhp->frame_count ? adhp->trailing_padding : 0);
 }
 
